# Railway tự cấp: tham chiếu ${{Postgres.DATABASE_URL}} trong biến của service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gaia
NODE_ENV=production
# Lần chạy đầu: tạo admin nếu chưa có tài khoản nào. Đăng nhập được rồi thì xoá ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Chỉ cần khi frontend gọi thẳng API khác domain (không qua rewrite của Vercel).
ALLOWED_ORIGINS=
